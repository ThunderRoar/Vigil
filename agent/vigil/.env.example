# ADK / Vertex AI config
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=your-project-region

# Elastic MCP connection (FILL THESE IN)
# ELASTIC_MCP_URL = your Kibana URL + /api/agent_builder/mcp
ELASTIC_MCP_URL=https://<your-kibana-url>/api/agent_builder/mcp
ELASTIC_API_KEY=<your-elastic-api-key>

# Optional: gemini-2.5-flash (fast/cheap) or gemini-2.5-pro (stronger reasoning)
VIGIL_MODEL=gemini-2.5-flash
